rules_version = '2';
service cloud.firestore { match /databases/{db}/documents {
  match /{col}/{id} {
    allow read: if col.matches('krathongs-.*') || col.matches('players-.*');
    allow create: if col.matches('krathongs-.*') && request.resource.data.name is string && request.resource.data.name.size() <= 20
      && request.resource.data.message is string && request.resource.data.message.size() <= 200 && request.resource.data.likes == 0;
    allow update: if col.matches('krathongs-.*') && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes'])
      && request.resource.data.likes == resource.data.likes + 1;
    allow write: if col.matches('players-.*') && request.resource.data.n is string && request.resource.data.n.size() <= 20;
    allow delete: if col.matches('players-.*');
  }
  match /stats/{day} { allow read: if true; allow write: if request.resource.data.diff(resource == null ? {} : resource.data).affectedKeys().hasOnly(['count']); }
}}
